# Auth.js (AUTH_* preferred; NEXTAUTH_* aliases still work)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (AUTH_GOOGLE_* inferred by Auth.js; GOOGLE_* used as fallback)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: apply schema with `npm run db:migrate`
DATABASE_URL=
SUPABASE_ACCESS_TOKEN=

# HMAC key for Gmail OAuth state (any random 32+ char string)
GMAIL_OAUTH_HMAC_SECRET=

# AES-256 token encryption key — 64 hex chars = 32 bytes.
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')|process.stdout.write"
TOKEN_ENCRYPTION_KEY=

# LLM (Gemini): LLM_PROVIDER=google
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
